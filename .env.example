# EC2의 저장소 루트에 .env로 복사해 실제 값으로 변경합니다.
COMPOSE_PROFILES=local-db
# 프론트엔드(Nginx) 호스트 포트. 3000이 다른 프로그램에 점유된 환경이 있어 기본값은 3333.
FRONTEND_PORT=3333
MARIADB_DATABASE=mockinv
MARIADB_USER=mockinv
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me
# Quant research DB (PostgreSQL). QUANT_DATABASE_URL overrides these when using an external DB.
QUANT_DB_NAME=quant_research
QUANT_DB_USER=quant
QUANT_DB_PASSWORD=change-me
# QUANT_DATABASE_URL=postgresql+psycopg://quant:change-me@postgres:5432/quant_research
# local(기본): 교육용 기본값 허용. public: 기본·32자 미만 SECRET_KEY나 기본 DB_PASSWORD면 기동 거부(settings.py).
APP_PROFILE=local
# public에서 필수: 관리자 주소(admin@admin.com 외). 계정은 `flask --app app create-admin`으로 만든다.
ADMIN_EMAIL=
# 레이트 리밋. 비우면 local은 꺼짐, public은 켜짐. public은 redis:// 같은 공유 저장소가 필요하다.
RATELIMIT_ENABLED=
RATELIMIT_STORAGE_URI=
# 백엔드 앞 리버스 프록시 수(Compose의 nginx 뒤면 1, 직접 실행이면 0).
TRUSTED_PROXY_COUNT=
# 백엔드는 비루트로 실행된다. AI Sheet의 LEAN 버튼(docker.sock)을 쓰려면 소켓 그룹 ID를 적는다.
# Linux: stat -c %g /var/run/docker.sock
DOCKER_SOCKET_GID=
SECRET_KEY=change-me-to-a-long-random-value
# 비우면 qdrant_service.py가 인메모리 Qdrant를 사용합니다.
QDRANT_URL=
CMC_API_KEY=
ANTHROPIC_API_KEY=
# AI 리서치(초대 코드 전용). 켜려면 월 예산을 정하고, public은 무작위 pepper(32자 이상)를 넣습니다.
# 초대 코드 발급: docker compose exec python-backend flask --app app create-invite --label 이름
AI_ENABLED=false
AI_MONTHLY_BUDGET_USD=0
AI_MODEL=claude-opus-5-5
AI_INVITE_PEPPER=

# 자연어 명령 라우터(TypeSafe Jev): 기본 꺼짐. 켜면 월 예산(USD)과 API 키가 필요하다.
# 명령 문장 한 줄만 TypeSafe로 보내고, 문장은 저장하지 않는다.
# 단가 파일 config/llm_pricing.local.toml(git 제외, 양식은 llm_pricing.example.toml)도 필요하다. 없으면 호출을 거절한다.
JEV_ENABLED=false
JEV_MONTHLY_BUDGET_USD=0
TYPESAFE_API_KEY=
# 공시 레이더(OpenDART, local 전용). 비어 있으면 worker가 수집 작업을 걸지 않는다.
DART_API_KEY=

# 한국투자증권 KIS Developers 모의투자 API (실제 값은 .env에만 입력하고 커밋하지 않습니다.)
# 비워 두면 저장소 루트의 kis.key를 읽습니다. 채우면 kis.key보다 우선합니다.
# KIS_ACCOUNT_NO는 'CANO-계좌상품코드'(예: 12345678-01) 한 값으로 적습니다.
# 하이픈 앞 8자리가 CANO, 뒤 2자리가 계좌상품코드이며 코드는 임의로 바꾸지 않습니다.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
# 신규 배포는 아래 모의투자 전용 변수 사용을 권장합니다. KIS_ENVIRONMENT는 paper 외 값을 거부합니다.
KIS_ENVIRONMENT=paper
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT_NO=
# KIS 실전 잔고조회 전용(읽기 전용). 모의투자 키를 입력하면 조회가 거부됩니다.
# 실전 Open API에서 별도로 발급한 값과 실제 계좌를 사용하며, OWNER_EMAIL 회원만 조회할 수 있습니다.
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_ACCOUNT_NO=
KIS_REAL_OWNER_EMAIL=
# HTTPS 운영 배포에서는 true로 설정합니다.
SESSION_COOKIE_SECURE=false

# KB증권 Open API (실제 값은 kb.key 또는 배포 비밀 환경변수에만 설정)
# 비워 두면 저장소 루트의 kb.key를 읽습니다.
KB_APP_KEY=
KB_APP_SECRET=

# Alpaca Paper Trading (실제 값은 .env 또는 비밀 관리 도구에만 설정)
# 비워 두면 저장소 루트의 al.key를 읽습니다. Paper 엔드포인트만 사용합니다.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# AWS SSM Parameter Store 연동 트랙(aws_secret_store.py, broker_test_aws.py,
# alpaca_test_aws.py)에서만 사용합니다. kis.key/kb.key/al.key 기반 기존 모듈은
# 이 값들과 무관하게 그대로 동작합니다. EC2에서 IAM 인스턴스 프로파일을 쓰면
# 아래 액세스 키 3종은 비워 두세요.
AWS_REGION=
AWS_SSM_PARAMETER_PREFIX=/stock-coin-trade
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# 운영 환경에서는 로컬 MariaDB 프로필을 비우고 외부 DB를 지정합니다.
# DB_HOST=your-db-host
# DB_PORT=3306
# DB_NAME=mockinv
# DB_USER=mockinv
# DB_PASSWORD=change-me

# 운영 오버레이에는 본인 ECR 레지스트리와 푸시한 local-* 이미지 태그를 명시합니다.
# scripts/ec2/deploy.sh 실행 시 ECR_REGISTRY와 IMAGE_TAG를 셸에 export합니다.
# scripts/ecr-push.sh 실행 시 AWS_ACCOUNT_ID를 셸에 export합니다.
ECR_REGISTRY=
IMAGE_TAG=

# EC2의 저장소 루트에 .env로 복사해 실제 값으로 변경합니다.
COMPOSE_PROFILES=local-db
# 프론트엔드(Nginx) 호스트 포트. 3000이 다른 프로그램에 점유된 환경이 있어 기본값은 3333.
FRONTEND_PORT=3333
MARIADB_DATABASE=mockinv
MARIADB_USER=mockinv
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me
# Quant research DB (PostgreSQL). QUANT_DATABASE_URL overrides these when using an external DB.
QUANT_DB_NAME=quant_research
QUANT_DB_USER=quant
QUANT_DB_PASSWORD=change-me
# QUANT_DATABASE_URL=postgresql+psycopg://quant:change-me@postgres:5432/quant_research
# OHLCV DB 및 자동 수집. major는 내장 주요 24종목, all은 tickers 전체,
# 또는 005930,000660처럼 쉼표로 종목을 지정합니다.
# OHLCV_DATABASE_URL=postgresql+psycopg://admin:change-me@pg-stock:5432/admin
OHLCV_SYNC_ENABLED=true
OHLCV_SYNC_TICKERS=major
OHLCV_SYNC_PROVIDER=naver
OHLCV_SYNC_START_YEAR=2020
OHLCV_SYNC_CORRECTION_DAYS=7
# 원본 증분 수집과 집계 스냅샷 갱신을 하루 한 번 실행할 시각(Asia/Seoul)
OHLCV_SYNC_HOUR=18
OHLCV_SYNC_MINUTE=20
SECRET_KEY=change-me-to-a-long-random-value
ADMIN_EMAIL=admin@example.com
DEMO_SEED_ENABLED=true
# ARIA 암복호화 데모의 서버 키(비우면 개발용 기본값 사용)
ARIA_DEMO_KEY=
# 비우면 qdrant_service.py가 인메모리 Qdrant를 사용합니다.
QDRANT_URL=
CMC_API_KEY=
# 예: CMC_API_KEY=your_coinmarketcap_api_key
ANTHROPIC_API_KEY=
# 예: ANTHROPIC_API_KEY=sk-ant-api03-your-key

# 모든 인증정보는 .env에만 입력합니다. *.key 파일 fallback은 지원하지 않습니다.
# 한국투자증권 KIS Developers 모의투자 API
# 예: KIS_PAPER_APP_KEY=PSxxxxxxxxxxxxxxxxxxxxxxxx
# 예: KIS_PAPER_APP_SECRET=your_kis_paper_app_secret
# KIS_PAPER_ACCOUNT_NO는 'CANO-계좌상품코드'(예: 12345678-01) 한 값으로 적습니다.
# 하이픈 앞 8자리가 CANO, 뒤 2자리가 계좌상품코드이며 코드는 임의로 바꾸지 않습니다.
KIS_ENVIRONMENT=paper
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT_NO=
# 웹 모의주문 1회 안전 한도
KIS_PAPER_MAX_ORDER_AMOUNT=10000000
KIS_PAPER_MAX_ORDER_QUANTITY=1000
# KIS 실전 잔고조회 전용(읽기 전용). 모의투자 키를 입력하면 조회가 거부됩니다.
# 실전 Open API에서 별도로 발급한 값과 실제 계좌를 사용하며, OWNER_EMAIL 회원만 조회할 수 있습니다.
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_ACCOUNT_NO=
KIS_REAL_OWNER_EMAIL=
# HTTPS 운영 배포에서는 true로 설정합니다.
SESSION_COOKIE_SECURE=false

# KB증권 Open API
# 예: KB_APP_KEY=your_kb_app_key
# 예: KB_APP_SECRET=your_kb_app_secret
KB_APP_KEY=
KB_APP_SECRET=
# 두 번째 KB 키를 보존해야 하는 경우(현재 앱에서는 사용하지 않음)
KB_SECONDARY_APP_KEY=
KB_SECONDARY_APP_SECRET=

# Alpaca Paper Trading — Paper 엔드포인트만 사용
# 예: ALPACA_API_KEY=PKxxxxxxxxxxxxxxxxxxxx
# 예: ALPACA_SECRET_KEY=your_alpaca_paper_secret
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# 별도 참고용 식별자를 보존할 때 사용(현재 앱에서는 사용하지 않음)
ALPACA_REFERENCE_KEY=

# 자격증명 출처: 비우면(로컬) .env의 브로커 키를 쓰고, 서버 배포에서 aws로 두면
# alpaca/kis/kb 자격증명을 AWS Secrets Manager에서 읽습니다.
CREDENTIAL_SOURCE=

# AWS Secrets Manager 연동은 aws_secret_store.py, broker_test_aws.py,
# alpaca_test_aws.py에서만 사용합니다. EC2에서 IAM 인스턴스 프로파일을 쓰면
# 아래 액세스 키 3종은 비워 둡니다. 로컬 예시는 실제 값으로 교체하세요.
AWS_REGION=
# 예: AWS_REGION=ap-northeast-2
AWS_SECRETS_MANAGER_PREFIX=stock-coin-trade
# 고객 관리형 KMS 키를 사용할 때만 ARN 또는 Key ID를 입력합니다.
AWS_SECRETS_MANAGER_KMS_KEY_ID=
# 로컬 프로필은 docker-compose.aws-profile.yml로만 전달합니다. EC2에서는 IAM Role을 사용하세요.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# 예: AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
# 예: AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# 운영 환경에서는 로컬 MariaDB 프로필을 비우고 외부 DB를 지정합니다.
# DB_HOST=43.201.14.160
# DB_PORT=3306
# DB_NAME=mockinv
# DB_USER=mockinv
# DB_PASSWORD=change-me

# docker-compose.prod.yml이 참조하는 ECR 이미지 좌표(운영 배포/로컬 백업 공용).
# 기본값은 stock-coin-trade용 ECR이며 필요할 때만 재정의합니다. 자세한 내용은
# deploy.md의 "ECR 기반 배포" 절 참고.
# ECR_REGISTRY=086015456585.dkr.ecr.ap-northeast-2.amazonaws.com
# IMAGE_TAG=latest

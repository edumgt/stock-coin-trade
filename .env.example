# EC2의 저장소 루트에 .env로 복사해 실제 값으로 변경합니다.
COMPOSE_PROFILES=local-db
# 프론트엔드(Nginx) 호스트 포트. 3000이 다른 프로그램에 점유된 환경이 있어 기본값은 3333.
FRONTEND_PORT=3333
MARIADB_DATABASE=mockinv
MARIADB_USER=mockinv
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me
# Quant research DB (PostgreSQL). QUANT_DATABASE_URL overrides these when using an external DB.
QUANT_DB_NAME=quant_research
QUANT_DB_USER=quant
QUANT_DB_PASSWORD=change-me
# QUANT_DATABASE_URL=postgresql+psycopg://quant:change-me@postgres:5432/quant_research
SECRET_KEY=change-me-to-a-long-random-value
# 비우면 qdrant_service.py가 인메모리 Qdrant를 사용합니다.
QDRANT_URL=
CMC_API_KEY=
ANTHROPIC_API_KEY=

# 한국투자증권 KIS Developers 모의투자 API (실제 값은 .env에만 입력하고 커밋하지 않습니다.)
# 비워 두면 저장소 루트의 kis.key를 읽습니다. 채우면 kis.key보다 우선합니다.
# KIS_ACCOUNT_NO는 'CANO-계좌상품코드'(예: 12345678-01) 한 값으로 적습니다.
# 하이픈 앞 8자리가 CANO, 뒤 2자리가 계좌상품코드이며 코드는 임의로 바꾸지 않습니다.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
# 신규 배포는 아래 모의투자 전용 변수 사용을 권장합니다. KIS_ENVIRONMENT는 paper 외 값을 거부합니다.
KIS_ENVIRONMENT=paper
KIS_PAPER_APP_KEY=
KIS_PAPER_APP_SECRET=
KIS_PAPER_ACCOUNT_NO=
# KIS 실전 잔고조회 전용(읽기 전용). 모의투자 키를 입력하면 조회가 거부됩니다.
# 실전 Open API에서 별도로 발급한 값과 실제 계좌를 사용하며, OWNER_EMAIL 회원만 조회할 수 있습니다.
KIS_REAL_APP_KEY=
KIS_REAL_APP_SECRET=
KIS_REAL_ACCOUNT_NO=
KIS_REAL_OWNER_EMAIL=
# HTTPS 운영 배포에서는 true로 설정합니다.
SESSION_COOKIE_SECURE=false

# KB증권 Open API (실제 값은 kb.key 또는 배포 비밀 환경변수에만 설정)
# 비워 두면 저장소 루트의 kb.key를 읽습니다.
KB_APP_KEY=
KB_APP_SECRET=

# Alpaca Paper Trading (실제 값은 .env 또는 비밀 관리 도구에만 설정)
# 비워 두면 저장소 루트의 al.key를 읽습니다. Paper 엔드포인트만 사용합니다.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# AWS Secrets Manager 연동은 aws_secret_store.py, broker_test_aws.py,
# alpaca_test_aws.py에서만 사용하며 기존 키 파일 모듈은
# 이 값들과 무관하게 그대로 동작합니다. EC2에서 IAM 인스턴스 프로파일을 쓰면
# 아래 액세스 키 3종은 비워 두세요.
AWS_REGION=
AWS_SECRETS_MANAGER_PREFIX=stock-coin-trade
# 고객 관리형 KMS 키를 사용할 때만 ARN 또는 Key ID를 입력합니다.
AWS_SECRETS_MANAGER_KMS_KEY_ID=
AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# 운영 환경에서는 로컬 MariaDB 프로필을 비우고 외부 DB를 지정합니다.
# DB_HOST=43.201.14.160
# DB_PORT=3306
# DB_NAME=mockinv
# DB_USER=mockinv
# DB_PASSWORD=change-me

# docker-compose.prod.yml이 참조하는 ECR 이미지 좌표(운영 배포/로컬 백업 공용).
# 기본값은 stock-coin-trade용 ECR이며 필요할 때만 재정의합니다. 자세한 내용은
# deploy.md의 "ECR 기반 배포" 절 참고.
# ECR_REGISTRY=086015456585.dkr.ecr.ap-northeast-2.amazonaws.com
# IMAGE_TAG=latest
